{
  // Solo comprueba (pnpm check en tools/); quien compila es esbuild (pnpm build).
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["globales.d.ts", "gestos.ts", "juego", "mesa", "partida", "tipos"]
}
