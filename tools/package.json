{
  "name": "piles-tools",
  "private": true,
  "type": "module",
  "description": "Herramientas de piles: el empaquetado del cliente (build), pruebas con sockets reales (repro/) y con navegador (browser/). Ver README.md.",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "check": "tsc -p ../client",
    "build": "esbuild ../client/juego/index.ts --bundle --format=iife --target=es2022 --outfile=../client/dist/piles.js --log-level=warning --alias:pixi.js=./node_modules/pixi.js --alias:html-to-image=./node_modules/html-to-image --minify --sourcemap --sources-content=false"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "pixi.js": "^8.22.0"
  }
}
