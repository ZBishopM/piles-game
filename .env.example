# Las dos únicas variables que lee el servidor.
# El resto de lo que había aquí (DATABASE_URL, SERVER_HOST, CORS_ALLOW_ORIGIN)
# no lo leía nadie, y SERVER_PORT ni siquiera era el nombre correcto.

# Puerto de escucha (3000 por defecto). Producción usa 3000 y beta 3010.
PORT=3000

# Nivel de log de tracing_subscriber
RUST_LOG=info
